/* 全局样式。数值不是随便定的，对应 docs/06-界面规范.md 的硬性要求：
   正文 ≥16pt、按钮文字 ≥18pt、主按钮高 ≥56px、可点区域 ≥44px。
   浅色高对比，不做深色模式 —— 长辈更习惯白底黑字。 */

QWidget {
    background: #f5f7fa;
    color: #1f2329;
    font-family: "Microsoft YaHei", "微软雅黑", sans-serif;
    font-size: 16pt;
}

QLabel[role="title"]   { font-size: 26pt; font-weight: bold; }
QLabel[role="hint"]    { font-size: 14pt; color: #5c6672; }
QLabel[role="status"]  { font-size: 20pt; font-weight: bold; }
QLabel[role="ok"]      { font-size: 24pt; font-weight: bold; color: #1a9c3c; }
QLabel[role="ok-small"] { font-size: 15pt; color: #1a9c3c; }
QLabel[role="warn"]    { font-size: 16pt; color: #c8460f; }
QLabel[role="section"] { font-size: 17pt; font-weight: bold; }

/* 普通按钮。
   高度**上下都钉死**：只写 min-height 时，按钮在有余量的布局里会被拉高，
   同一屏上几个按钮胖瘦不一，看着就是"变形"。padding 只给左右，
   不和高度打架。 */
QPushButton {
    background: #ffffff;
    border: 2px solid #c8d0da;
    border-radius: 10px;
    padding: 0 22px;
    min-height: 56px;
    max-height: 56px;
    font-size: 18pt;
}
QPushButton:hover   { border-color: #1677ff; }
QPushButton:pressed { background: #eef4ff; }
QPushButton:disabled {
    color: #a3adb8;
    background: #eceff3;
    border-color: #dde2e8;
}

/* 主按钮：每个页面同一位置、同一颜色的那个大绿钮 */
QPushButton[role="primary"] {
    background: #1a9c3c;
    color: #ffffff;
    border: none;
    border-radius: 12px;
    padding: 0 24px;
    min-height: 68px;
    max-height: 68px;
    font-size: 24pt;
    font-weight: bold;
}
/* 证件页的主按钮矮一档：那一行还有「保存成 PDF / 另存为…」两个白按钮，
   高度不一样看着像没做完。**这里写 60 而白按钮写 56 是对的** ——
   白按钮有 2px 边框，min-height 管的是内容区，加上上下边框正好也是 60px。 */
QPushButton[role="primary"][compact="true"] {
    min-height: 60px;
    max-height: 60px;
    font-size: 21pt;
}
QPushButton[role="primary"]:hover   { background: #168733; }
QPushButton[role="primary"]:pressed { background: #12712b; }
QPushButton[role="primary"]:disabled { background: #b7c3ce; color: #eef1f4; }

/* 返回按钮：永远在左上角同一个位置 */
QPushButton[role="back"] {
    background: transparent;
    border: none;
    color: #1677ff;
    font-size: 20pt;
    padding: 0 12px;
    min-height: 48px;
    max-height: 48px;
    text-align: left;
}
QPushButton[role="back"]:hover { text-decoration: underline; }
QPushButton[role="back"]:pressed { color: #0d5bd6; }

/* 加减按钮：长辈点不准小箭头，所以用大方块 */
QPushButton[role="stepper"] {
    min-width: 56px;
    max-width: 56px;
    min-height: 56px;
    max-height: 56px;
    font-size: 26pt;
    font-weight: bold;
    padding: 0;
}

/* 二选一 / 多选一的大按钮组，代替下拉框。
   padding 给得紧一点：证件页要在一行里排六个（身份证/银行卡/…/自动认），
   1024 宽的小屏上按钮一胖，整列的最小宽度就把 A4 预览挤没了。 */
QPushButton[role="choice"] {
    min-height: 48px;
    max-height: 48px;
    padding: 0 12px;
    font-size: 17pt;
}
QPushButton[role="choice"]:checked {
    background: #1677ff;
    color: #ffffff;
    border-color: #1677ff;
}
QPushButton[role="choice"]:checked:hover { background: #0d6ae8; }

/* 图片框里的小按钮（转一下 / 去掉 / 粘贴）。压到 44px —— 正好是可点区域的
   下限，再矮就违规了。这一页控件多，每省 8px 都是给 A4 预览的。 */
QPushButton[role="mini"] {
    min-height: 44px;
    max-height: 44px;
    padding: 0 12px;
    font-size: 18pt;
}

/* 页面上那块"把图片放这里"的空地：虚线框 + 一句大字。
   和证件页的图片框同一套视觉语言（虚线 = 这里能放东西）。 */
QFrame[role="dropzone"] {
    background: #ffffff;
    border: 2px dashed #b9c3cf;
    border-radius: 14px;
}
QFrame[role="dropzone"]:hover { border-color: #1677ff; background: #f7fbff; }
QLabel[role="dropzone-text"] { font-size: 19pt; color: #3d4652; background: transparent; }

/* 只用来接点击和拖拽的透明外壳（照片页的左右对比、OCR 页的原图外面套一层） */
QFrame[role="plain"] { background: transparent; border: none; }

/* 证件页的两个图片框：空的时候虚线框 +「点这里选图片」，放好之后实线框 + 缩略图。
   虚线是"这里能放东西"的通用暗示，长辈也认得。 */
QFrame[role="cardslot"] {
    background: #ffffff;
    border: 2px dashed #b9c3cf;
    border-radius: 14px;
}
QFrame[role="cardslot"]:hover { border-color: #1677ff; background: #f7fbff; }
QFrame[role="cardslot"][filled="true"] { border: 2px solid #dfe5ec; }
QFrame[role="cardslot"] QLabel { background: transparent; }

/* 框里的缩略图：不要再套一层灰底的框，不然框中框看着很乱 */
QFrame[role="cardslot"] QFrame[role="thumb"] {
    background: transparent;
    border: none;
}
/* 空框里那句「点这里选图片」是这一格的主行动，比普通提示大一号、颜色也深一些 */
QFrame[role="cardslot"] QFrame[role="thumb"] QLabel {
    font-size: 17pt;
    color: #3d4652;
}

/* 卡片和预览框里的文字必须透明背景：上面那条 QWidget 规则会给每个 QLabel
   刷上灰底，在白色卡片上就显出一个个灰方块（截图里看得很明显）。 */
QPushButton[role="card"] QLabel,
QFrame[role="preview"] QLabel,
QFrame[role="filecard"] QLabel { background: transparent; }

/* 首页大卡片。卡片本身是要跟着窗口长大的，所以只钉最小值，不钉最大值 */
QPushButton[role="card"] {
    background: #ffffff;
    border: 2px solid #dfe5ec;
    border-radius: 18px;
    min-width: 260px;
    min-height: 180px;
    max-height: 16777215;
    padding: 18px;
    font-size: 16pt;
    text-align: center;
}
QPushButton[role="card"]:hover   { border-color: #1677ff; background: #f7fbff; }
QPushButton[role="card"]:pressed { background: #eef4ff; }

/* 证件页的位置行：拖图片进来的时候整行高亮，让人知道松手就放这儿 */
QWidget[dropping="true"] {
    background: #eef6ff;
    border: 2px dashed #1677ff;
    border-radius: 10px;
}

/* 文件卡片（微信收到的文件列表） */
QFrame[role="filecard"] {
    background: #ffffff;
    border: 2px solid #e3e8ee;
    border-radius: 14px;
}

QProgressBar {
    border: 2px solid #c8d0da;
    border-radius: 10px;
    min-height: 40px;
    text-align: center;
    font-size: 16pt;
    background: #ffffff;
}
QProgressBar::chunk { background: #1677ff; border-radius: 8px; }

QSlider::groove:horizontal { height: 12px; background: #dfe5ec; border-radius: 6px; }
QSlider::sub-page:horizontal { background: #1677ff; border-radius: 6px; }
QSlider::handle:horizontal {
    width: 40px; height: 40px; margin: -15px 0;
    background: #ffffff; border: 3px solid #1677ff; border-radius: 20px;
}

QComboBox { min-height: 48px; font-size: 16pt; padding: 6px 12px; background: #ffffff;
            border: 2px solid #c8d0da; border-radius: 8px; }
QComboBox QAbstractItemView { font-size: 16pt; }

QTextEdit, QPlainTextEdit {
    background: #ffffff; border: 2px solid #dfe5ec; border-radius: 10px;
    font-size: 15pt; padding: 10px;
}

QScrollArea { border: none; background: transparent; }
QScrollBar:vertical { width: 18px; background: #eceff3; }
QScrollBar::handle:vertical { background: #c0c8d2; border-radius: 9px; min-height: 40px; }
QScrollBar::add-line, QScrollBar::sub-line { height: 0; width: 0; }

QFrame[role="preview"] {
    /* 底色刻意比纸白一点点：去底之后的纸是纯白的，衬在纯白框里就看不出
       纸的边界在哪，长辈会以为"图没出来"。 */
    background: #eceff4;
    border: 2px solid #dfe5ec;
    border-radius: 12px;
}
